---
const { title = "MADEBYAL" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="MADEBYAL — photography, film and writing by Al Ibrahim"
    />
    <title>{title}</title>
  </head>

  <body>
    <aside class="sidebar">
      <a class="logo" href="/">MADEBYAL</a>

      <nav>
        <div class="section">
          <a class="section-title" href="/">PHOTOS</a>
          <a href="/overview">Overview</a>
          <a href="/portraits">Portraits</a>
          <a href="/events">Events</a>
          <a href="/editorial">Editorial</a>
          <a href="/behind-the-scenes">Behind the Scenes</a>
        </div>

        <div class="section">
          <a class="section-title" href="/videos">VIDEOS</a>
          <a href="/showreel">Showreel</a>
          <a href="/youtube">Youtube Videos</a>
          <a href="/music-videos">Music Videos</a>
          <a href="/short-films">Short Films</a>
          <a href="/short-docs">Short Docs</a>
          <a href="/personal">Personal</a>
        </div>

        <div class="section">
          <a class="section-title" href="/words">WORDS</a>
        </div>

        <div class="section">
          <a class="section-title" href="/projects">OTHER PROJECTS</a>
        </div>

        <div class="secondary">
          <a href="/about">About</a>
          <a href="/now">Now</a>
          <a href="/contact">Contact</a>
        </div>
      </nav>
    </aside>

    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    background: #fff;
    color: #171717;
    font-family: Arial, Helvetica, sans-serif;
  }

  body {
    min-height: 100vh;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: 220px;
    height: 100vh;
    padding: 48px 36px;
    background: #fff;
  }

  .logo {
    display: block;
    margin-bottom: 38px;
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -1.2px;
  }

  nav {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .section-title {
    font-weight: 700;
    margin-bottom: 3px;
  }

  nav a {
    font-size: 14px;
    line-height: 1.2;
  }

  nav a:hover {
    opacity: 0.55;
  }

  .secondary {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 6px;
  }

  main {
    margin-left: 220px;
    min-height: 100vh;
    padding: 40px 36px 60px 24px;
  }

  @media (max-width: 760px) {
    .sidebar {
      position: static;
      width: 100%;
      height: auto;
      padding: 24px;
    }

    .logo {
      margin-bottom: 18px;
    }

    nav {
      display: none;
    }

    main {
      margin-left: 0;
      padding: 0 16px 40px;
    }
  }
</style>