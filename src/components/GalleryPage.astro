---
import Layout from "../layouts/Layout.astro";
import JustifiedGallery from "./JustifiedGallery.astro";
import { sanity, urlFor } from "../lib/sanity";

const { slug, title } = Astro.props;

const gallery = await sanity.fetch(
  `*[_type == "photoGallery" && slug.current == $slug][0]{
    title,
    homepageImage,
    images
  }`,
  { slug }
);

const images =
  gallery?.images?.map((image) =>
    urlFor(image).width(1800).quality(85).url()
  ) ?? [];

const socialImageSource =
  gallery?.homepageImage ?? gallery?.images?.[0];

const socialImage = socialImageSource
  ? urlFor(socialImageSource)
      .width(2000)
      .quality(88)
      .url()
  : null;

const seoDescriptions: Record<string, string> = {
  events:
    "Event photography in Berlin and across Europe by Al Ibrahim, focused on people, atmosphere and authentic moments.",
  portraits:
    "Portrait photography in Berlin by Al Ibrahim, creating warm, expressive images with a natural and human approach.",
  editorial:
    "Documentary and editorial photography by Berlin-based photographer Al Ibrahim, focused on people, place and real moments.",
};

const seoTitles: Record<string, string> = {
  events: "Event Photographer Berlin | MADEBYAL",
  portraits: "Portrait Photographer Berlin | MADEBYAL",
  editorial: "Documentary & Editorial Photographer Berlin | MADEBYAL",
};

const seoTitle =
  seoTitles[slug] ?? `${title} Photography — MADEBYAL`;

const seoDescription =
  seoDescriptions[slug] ??
  `${title} photography by Berlin-based photographer Al Ibrahim.`;
---

<Layout
  title={seoTitle}
  description={seoDescription}
  image={socialImage}
>
  <JustifiedGallery images={images} />
</Layout>