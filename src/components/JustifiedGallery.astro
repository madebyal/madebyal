---
const { images } = Astro.props;
---

<div class="justified-gallery" data-gallery>
  {images.map((image, index) => (
    <img
      src={image.src}
      srcset={image.srcset}
      sizes="(max-width: 760px) calc(100vw - 32px), calc(100vw - 300px)"
      width={image.width}
      height={image.height}
      alt={image.alt}
      loading={index < 3 ? "eager" : "lazy"}
      fetchpriority={index < 2 ? "high" : "auto"}
    />
  ))}
</div>

<script>
  import justifiedLayout from "justified-layout";

  const galleries = document.querySelectorAll("[data-gallery]");

  galleries.forEach((gallery) => {
    const images = Array.from(gallery.querySelectorAll("img"));

    function layoutGallery() {
      const width = gallery.clientWidth;

      if (!width || !images.length) return;

      const ratios = images.map((img) => {
        const width = Number(img.getAttribute("width"));
        const height = Number(img.getAttribute("height"));

        if (!width || !height) return 1;

        return width / height;
      });

      const geometry = justifiedLayout(ratios, {
        containerWidth: width,
        targetRowHeight: 500,
        targetRowHeightTolerance: 0.25,
        boxSpacing: 10,
        containerPadding: 0,
      });

      gallery.style.height = `${geometry.containerHeight}px`;

      geometry.boxes.forEach((box, index) => {
        const img = images[index];

        img.style.left = `${box.left}px`;
        img.style.top = `${box.top}px`;
        img.style.width = `${box.width}px`;
        img.style.height = `${box.height}px`;
      });

      gallery.classList.add("is-ready");
    }

    layoutGallery();

    const resizeObserver = new ResizeObserver(layoutGallery);
    resizeObserver.observe(gallery);
  });
</script>

<style>
  .justified-gallery {
    position: relative;
    width: 100%;
  }

  .justified-gallery img {
    position: absolute;
    display: block;
    object-fit: cover;
    visibility: hidden;
  }

  .justified-gallery.is-ready img {
    visibility: visible;
  }

  @media (max-width: 760px) {
    .justified-gallery img {
      position: static;
      width: 100% !important;
      height: auto !important;
      margin-bottom: 10px;
    }

    .justified-gallery {
      height: auto !important;
    }
  }
</style>