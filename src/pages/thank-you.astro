---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Thank You — MADEBYAL"
  description="Thanks for getting in touch with MADEBYAL."
  noindex={true}
>
  <section class="thank-you">
    <p class="eyebrow">Message sent</p>

    <h1>Thanks — I’ve got your message.</h1>

    <p class="intro">
      I’ll get back to you as soon as I can.
    </p>

    <div class="links">
      <a href="/">Home</a>
      <a href="/film">View Film</a>
      <a href="/photography">View Photography</a>
    </div>
  </section>
</Layout>

<style>
  .thank-you {
    max-width: 900px;
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 40px 0 80px;
  }

  .eyebrow {
    margin: 0 0 16px;
    font-size: 13px;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1 {
    max-width: 800px;
    margin: 0;
    font-family: "Montserrat", Arial, Helvetica, sans-serif;
    font-size: clamp(38px, 5vw, 72px);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .intro {
    margin: 20px 0 0;
    font-size: 18px;
    line-height: 1.5;
    color: #555;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 40px;
  }

  .links a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .links a:hover {
    opacity: 0.5;
  }

  @media (max-width: 760px) {
    .thank-you {
      min-height: 65vh;
      padding: 30px 0 60px;
    }

    .links {
      gap: 16px;
    }
  }
</style>