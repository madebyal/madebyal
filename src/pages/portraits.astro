---
import Layout from "../layouts/Layout.astro";
import JustifiedGallery from "../components/JustifiedGallery.astro";
import { sanity, urlFor } from "../lib/sanity";

const gallery = await sanity.fetch(`
  *[_type == "photoGallery" && slug.current == "portraits"][0]{
    title,
    images
  }
`);

const images =
  gallery?.images?.map((image) =>
    urlFor(image).width(1800).quality(85).url()
  ) ?? [];
---

<Layout title="Portraits — MADEBYAL">
  <JustifiedGallery images={images} />
</Layout>