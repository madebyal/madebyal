---
import Layout from "../../layouts/Layout.astro";
import { sanity, urlFor } from "../../lib/sanity";

const projects = await sanity.fetch(`
  *[_type == "filmProject"] | order(featured desc, featuredOrder asc, _createdAt desc) {
    title,
    "slug": slug.current,
    category,
    poster,
    client,
    year,
    featured
  }
`);

const categoryLabels: Record<string, string> = {
  documentary: "Documentary",
  podcast: "People + Ideas",
  events: "Events",
  commercial: "Commercial",
  "film-music": "Film + Music",
};

function posterUrl(poster: any) {
  if (!poster) return null;

  return urlFor(poster)
    .width(1800)
    .quality(85)
    .url();
}
---

<Layout
  title="Filmmaker in Berlin — Documentary, Events & Commercial | MADEBYAL"
  description="Berlin-based filmmaker Al Amin Ibrahim creating documentary films, people-led interviews and courses, event films, commercial work and music-related projects across Germany and Europe."
>
  <section class="intro">
    <p class="eyebrow">Film</p>

    <h1>Stories in motion.</h1>

    <p class="description">
      Documentary, people and ideas, events, commercial work, film and music.
    </p>
  </section>

  <section class="project-grid">
    {
      projects.map((project, index) => (
        <a
          class:list={["project", { wide: index % 3 === 0 }]}
          href={`/film/project/${project.slug}`}
        >
          {
            project.poster ? (
              <img
                src={posterUrl(project.poster)}
                alt={project.title}
                loading={index === 0 ? "eager" : "lazy"}
              />
            ) : (
              <div class="placeholder"></div>
            )
          }

          <div class="meta">
            <div>
              <h2>{project.title}</h2>

              <p>
                {categoryLabels[project.category] ?? project.category}
                {project.client ? ` · ${project.client}` : ""}
              </p>
            </div>

            {project.year && <span>{project.year}</span>}
          </div>
        </a>
      ))
    }
  </section>
</Layout>

<style>
  .intro {
    padding: 18px 0 48px;
  }

  .eyebrow {
    margin: 0 0 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  h1 {
    margin: 0;
    font-size: clamp(36px, 4vw, 58px);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .description {
    margin: 18px 0 0;
    font-size: 16px;
    color: #555;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px 20px;
    padding-bottom: 80px;
  }

  .project {
    display: block;
  }

  .project.wide {
    grid-column: 1 / -1;
  }

  .project img,
  .placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: #111;
  }

  .project.wide img,
  .project.wide .placeholder {
    aspect-ratio: 16 / 9;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 10px;
  }

  .meta h2,
  .meta p,
  .meta span {
    margin: 0;
    font-size: 14px;
    font-weight: 400;
  }

  .meta p,
  .meta span {
    color: #777;
  }

  .meta p {
    margin-top: 3px;
  }

  .project:hover {
    opacity: 0.75;
  }

  @media (max-width: 900px) {
    .project-grid {
      grid-template-columns: 1fr;
    }

    .project.wide {
      grid-column: auto;
    }

    .project img,
    .project.wide img,
    .placeholder,
    .project.wide .placeholder {
      aspect-ratio: 4 / 3;
    }
  }
</style>