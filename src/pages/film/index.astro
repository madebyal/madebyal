---
import Layout from "../../layouts/Layout.astro";
import { sanity, urlFor } from "../../lib/sanity";

const projects = await sanity.fetch(`
  *[_type == "filmProject"] | order(featured desc, featuredOrder asc, _createdAt desc) {
    title,
    category,
    poster
  }
`);

function imageFor(category: string) {
  const project = projects.find(
    (project: any) => project.category === category && project.poster
  );

  if (!project?.poster) return null;

  return urlFor(project.poster)
    .width(1800)
    .quality(85)
    .url();
}

const categories = [
  {
    title: "Documentary",
    slug: "documentary",
    href: "/film/documentary",
    image: imageFor("documentary"),
  },
  {
    title: "People + Ideas",
    slug: "people-ideas",
    href: "/film/people-ideas",
    image: imageFor("podcast"),
  },
  {
    title: "Events",
    slug: "events",
    href: "/film/events",
    image: imageFor("events"),
  },
  {
    title: "Commercial",
    slug: "commercial",
    href: "/film/commercial",
    image: imageFor("commercial"),
  },
  {
    title: "Film + Music",
    slug: "film-music",
    href: "/film/film-music",
    image: imageFor("film-music"),
  },
];
---

<Layout
  title="Filmmaker in Berlin — Documentary, Events & Commercial | MADEBYAL"
  description="Berlin-based filmmaker Al Amin Ibrahim creating documentary films, people-led interviews and courses, event films, commercial work and music-related projects across Germany and Europe."
>
  <section class="intro">
    <p class="eyebrow">Film</p>

    <h1>Stories in motion.</h1>

    <p class="description">
      Documentary, people and ideas, events, commercial work, film and music.
    </p>
  </section>

  <section class="category-grid">
    {
      categories.map((category, index) => (
        <a
          class:list={["category", { wide: index === 4 }]}
          href={category.href}
        >
          {category.image ? (
            <img
              src={category.image}
              alt={`${category.title} film work by Al Ibrahim`}
              loading={index === 0 ? "eager" : "lazy"}
            />
          ) : (
            <div class="placeholder"></div>
          )}

          <div class="meta">
            <h2>{category.title}</h2>
            <span>View work →</span>
          </div>
        </a>
      ))
    }
  </section>
</Layout>

<style>
  .intro {
    padding: 18px 0 48px;
  }

  .eyebrow {
    margin: 0 0 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  h1 {
    margin: 0;
    font-size: clamp(36px, 4vw, 58px);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .description {
    margin: 18px 0 0;
    font-size: 16px;
    color: #555;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px 20px;
    padding-bottom: 80px;
  }

  .category {
    display: block;
  }

  .category.wide {
    grid-column: 1 / -1;
  }

  .category img,
  .placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: #eee;
  }

  .category.wide img,
  .category.wide .placeholder {
    aspect-ratio: 16 / 9;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 10px;
  }

  .meta h2,
  .meta span {
    margin: 0;
    font-size: 14px;
    font-weight: 400;
  }

  .meta span {
    color: #777;
  }

  .category:hover {
    opacity: 0.75;
  }

  @media (max-width: 900px) {
    .category-grid {
      grid-template-columns: 1fr;
    }

    .category.wide {
      grid-column: auto;
    }

    .category img,
    .category.wide img,
    .placeholder,
    .category.wide .placeholder {
      aspect-ratio: 4 / 3;
    }
  }
</style>