---
import Layout from "../../layouts/Layout.astro";
import { sanity, urlFor } from "../../lib/sanity";

const projects = await sanity.fetch(`
  *[_type == "project"] | order(featured desc, featuredOrder asc, _createdAt desc) {
    title,
    "slug": slug.current,
    projectType,
    year,
    coverImage,
    summary
  }
`);

const typeLabels: Record<string, string> = {
  personal: "Personal Project",
  bts: "Behind the Scenes",
  collaborative: "Collaborative Project",
  audio: "Podcast / Audio",
  other: "Other",
};

function coverUrl(image: any) {
  if (!image) return null;

  return urlFor(image)
    .width(1800)
    .quality(85)
    .url();
}
---

<Layout
  title="Creative Projects — Film, Photography & Audio | MADEBYAL"
  description="Personal and collaborative projects by Berlin-based filmmaker and photographer Al Ibrahim, including visual experiments, audio work and behind-the-scenes stories."
>
  <section class="intro">
    <p class="eyebrow">Projects</p>

    <h1>Personal and collaborative work.</h1>

    <p class="description">
      Self-contained projects, experiments, audio work and images from film sets.
    </p>
  </section>

  <section class="project-grid">
    {
      projects.map((project, index) => (
        <a
          class:list={["project", { wide: index % 3 === 0 }]}
          href={`/projects/${project.slug}`}
        >
          {project.coverImage ? (
            <img
              src={coverUrl(project.coverImage)}
              alt={project.title}
              loading={index === 0 ? "eager" : "lazy"}
            />
          ) : (
            <div class="placeholder"></div>
          )}

          <div class="meta">
            <div>
              <h2>{project.title}</h2>

              <p>
                {typeLabels[project.projectType] ?? project.projectType}
              </p>
            </div>

            {project.year && <span>{project.year}</span>}
          </div>

          {project.summary && (
            <p class="summary">{project.summary}</p>
          )}
        </a>
      ))
    }
  </section>
</Layout>

<style>
  .intro {
    padding: 18px 0 48px;
  }

  .eyebrow {
    margin: 0 0 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  h1 {
    margin: 0;
    font-size: clamp(36px, 4vw, 58px);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .description {
    margin: 18px 0 0;
    font-size: 16px;
    color: #555;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 56px 20px;
    padding-bottom: 80px;
  }

  .project {
    display: block;
  }

  .project.wide {
    grid-column: 1 / -1;
  }

  .project img,
  .placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: #eee;
  }

  .project.wide img,
  .project.wide .placeholder {
    aspect-ratio: 16 / 9;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 10px;
  }

  .meta h2,
  .meta p,
  .meta span {
    margin: 0;
    font-size: 14px;
    font-weight: 400;
  }

  .meta p,
  .meta span {
    color: #777;
  }

  .meta p {
    margin-top: 3px;
  }

  .summary {
    max-width: 620px;
    margin: 10px 0 0;
    font-size: 14px;
    line-height: 1.45;
    color: #555;
  }

  .project:hover {
    opacity: 0.75;
  }

  @media (max-width: 900px) {
    .project-grid {
      grid-template-columns: 1fr;
    }

    .project.wide {
      grid-column: auto;
    }

    .project img,
    .project.wide img,
    .placeholder,
    .project.wide .placeholder {
      aspect-ratio: 4 / 3;
    }
  }
</style>