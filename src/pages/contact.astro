---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact Al Amin — Berlin Filmmaker & Photographer | MADEBYAL"
  description="Get in touch with Berlin-based filmmaker and photographer Al Amin Ibrahim for documentary, events, portraits, commercial projects and people-led video work across Germany and Europe."
>
  <section class="contact-page">
    <div class="intro">
      <p class="eyebrow">Contact</p>

      <h1>Have a project in mind?</h1>

      <p class="description">
        I’m available for film and photography projects in Berlin and across Europe.
      </p>
    </div>

    <div class="contact-grid">
      <div class="details">
        <div class="detail">
          <p class="label">Email</p>
          <a href="mailto:hello@madebyal.net">
            hello@madebyal.net
          </a>
        </div>

        <div class="detail">
          <p class="label">Based in</p>
          <p>Berlin, Germany</p>
        </div>

        <div class="detail">
          <p class="label">Available for</p>
          <p>
            film, photography, events, documentary, podcasts,
            commercial work and selected creative projects.
          </p>
        </div>
      </div>

      <form
        id="contact-form"
        class="contact-form"
        action="https://formspree.io/f/xdeopyjb"
        method="POST"
      >

        <label>
          <span>Name</span>
          <input
            type="text"
            name="name"
            required
          />
        </label>

        <label>
          <span>Email</span>
          <input
            type="email"
            name="email"
            required
          />
        </label>

        <label>
          <span>Company / Organisation</span>
          <input
            type="text"
            name="company"
          />
        </label>

        <label>
          <span>What are you making?</span>
          <textarea
            name="message"
            rows="6"
            required
          ></textarea>
        </label>

        <label>
          <span>Approximate dates</span>
          <input
            type="text"
            name="dates"
            placeholder="e.g. October 2026"
          />
        </label>

        <button type="submit">
          Send enquiry →
        </button>
      </form>
    </div>
  </section>
</Layout>

<style>
  .contact-page {
    width: 100%;
    padding: 18px 0 80px;
  }

  .intro {
    padding-bottom: 35px;
  }

  .eyebrow,
  .label {
    margin: 0 0 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  h1 {
    margin: 0;
    font-size: clamp(42px, 5vw, 76px);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .description {
    max-width: 650px;
    margin: 22px 0 0;
    font-size: 18px;
    line-height: 1.5;
    color: #555;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(240px, 0.7fr) minmax(0, 1.3fr);
    gap: 80px;
    padding-top: 20px;
    border-top: 1px solid #ddd;
  }

  .details {
    display: flex;
    flex-direction: column;
    gap: 34px;
  }

  .detail p,
  .detail a {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
  }

  .detail a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .contact-form label {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .contact-form label span {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  input,
  textarea {
    width: 100%;
    padding: 10px 0;
    border: 0;
    border-bottom: 1px solid #aaa;
    border-radius: 0;
    background: transparent;
    color: #171717;
    font: inherit;
    font-size: 16px;
    outline: none;
  }

  textarea {
    resize: vertical;
  }

  input:focus,
  textarea:focus {
    border-bottom-color: #171717;
  }

  button {
    align-self: flex-start;
    margin-top: 10px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-size: clamp(26px, 3vw, 42px);
    letter-spacing: -0.03em;
    cursor: pointer;
  }

  button:hover {
    opacity: 0.55;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 60px;
    }
  }
</style>

<script>
  const form = document.getElementById("contact-form");

  if (form instanceof HTMLFormElement) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const submitButton = form.querySelector('button[type="submit"]');

      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = true;
        submitButton.textContent = "Sending...";
      }

      try {
        const response = await fetch(form.action, {
          method: form.method,
          body: new FormData(form),
          headers: {
            Accept: "application/json",
          },
        });

        if (response.ok) {
          window.location.href = "/thank-you";
          return;
        }

        alert("Something went wrong. Please try again.");
      } catch (error) {
        alert("Something went wrong. Please try again.");
      } finally {
        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = false;
          submitButton.textContent = "Send enquiry →";
        }
      }
    });
  }
</script>