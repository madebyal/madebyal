---
import Layout from "../layouts/Layout.astro";
import { PortableText } from "@portabletext/astro";
import { sanity, urlFor } from "../lib/sanity";

const page = await sanity.fetch(`
  *[_type == "page" && slug.current == "about"][0]{
    title,
    headline,
    intro,
    heroImage,
    body,
    location,
    services,
    availability
  }
`);

const portrait = page?.heroImage
  ? urlFor(page.heroImage)
      .width(1400)
      .quality(88)
      .url()
  : null;
---

<Layout
  title="About Al Amin — Berlin Filmmaker & Photographer | MADEBYAL"
  description="About Al Amin Ibrahim, a Berlin-based filmmaker and photographer working across documentary, events, portraits, interviews and creative projects in Germany and Europe."
>
  <section class="about-page">

    <section class="hero">
      <div class="portrait-wrap">
        {
          portrait ? (
            <img
              class="portrait"
              src={portrait}
              alt={page?.heroImage?.alt || "Al Ibrahim"}
            />
          ) : (
            <div class="portrait-placeholder">
              <span>Portrait</span>
            </div>
          )
        }
      </div>

      <div class="hero-copy">
        <p class="eyebrow">About</p>

        <h1>
          {page?.headline || "I make films and photographs about people."}
        </h1>

        {
          page?.intro && (
            <p class="lead">
              {page.intro}
            </p>
          )
        }
      </div>
    </section>

    <section class="about-grid">
      <div class="about-copy">
        {
          page?.body?.length > 0 ? (
            <PortableText value={page.body} />
          ) : (
            <p>Add your About text in Sanity.</p>
          )
        }
      </div>

      <aside class="details">
        {
          page?.location && (
            <div>
              <p class="label">Based in</p>
              <p>{page.location}</p>
            </div>
          )
        }

        {
          page?.services?.length > 0 && (
            <div>
              <p class="label">Working across</p>

              <p>
                {
                  page.services.map((service) => (
                    <>
                      {service}<br />
                    </>
                  ))
                }
              </p>
            </div>
          )
        }

        {
          page?.availability && (
            <div>
              <p class="label">Available</p>
              <p>{page.availability}</p>
            </div>
          )
        }

        <div>
          <a href="/contact">Work with me →</a>
        </div>
      </aside>
    </section>

  </section>
</Layout>

<style>
  .about-page {
    width: 100%;
    padding: 18px 0 100px;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(280px, 0.8fr) minmax(0, 1.2fr);
    gap: 70px;
    align-items: start;
    padding-bottom: 50px;
  }

  .portrait-wrap {
    width: 100%;
  }

  .portrait,
  .portrait-placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .portrait-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #eee;
    color: #888;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .eyebrow,
  .label {
    margin: 0 0 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  h1 {
    margin: 0;
    font-size: clamp(42px, 5vw, 76px);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .lead {
    max-width: 680px;
    margin: 28px 0 0;
    font-size: clamp(22px, 2.1vw, 30px);
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(240px, 0.6fr);
    gap: 80px;
    padding-top: 40px;
    border-top: 1px solid #ddd;
  }

  .about-copy {
    max-width: 760px;
  }

  .about-copy :global(p) {
    margin: 0 0 28px;
    font-size: 17px;
    line-height: 1.65;
  }

  .about-copy :global(h2) {
    margin: 48px 0 18px;
    font-size: 28px;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .about-copy :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .details {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .details p {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
  }

  .details a {
    font-size: 16px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .portrait-wrap {
      max-width: 520px;
    }

    .about-grid {
      grid-template-columns: 1fr;
      gap: 50px;
    }
  }
</style>