---
import Layout from "../layouts/Layout.astro";
import { sanity, urlFor } from "../lib/sanity";

const homepage = await sanity.fetch(`
  *[_type == "homepage"][0]{
    eyebrow,
    headline,
    intro,
    selectedWorkHeading,
    filmHeading,
    filmDescription,
    photographyHeading,
    photographyDescription,
    projectsHeading,
    projectsDescription,
    aboutHeading,
    aboutText,
    contactHeading,
    contactText,
    contactLinkText
  }
`);

const galleries = await sanity.fetch(`
  *[_type == "photoGallery" && slug.current in ["events", "portraits", "editorial"]]{
    title,
    "slug": slug.current,
    homepageImage,
    images
  }
`);

const featuredFilm = await sanity.fetch(`
  *[
    _type == "filmProject" &&
    featured == true &&
    defined(slug.current)
  ]
  | order(featuredOrder asc, _createdAt desc)[0]{
    title,
    "slug": slug.current,
    category,
    poster,
    client,
    year
  }
`);

function getGallery(slug: string) {
  return galleries.find((gallery) => gallery.slug === slug);
}

function homepageImage(slug: string) {
  const gallery = getGallery(slug);

  const image = gallery?.homepageImage ?? gallery?.images?.[0];

  if (!image) return null;

  return urlFor(image)
    .width(1800)
    .quality(85)
    .url();
}

function filmPoster(poster: any) {
  if (!poster) return null;

  return urlFor(poster)
    .width(2000)
    .quality(85)
    .url();
}

const eventImage = homepageImage("events");
const portraitImage = homepageImage("portraits");
const editorialImage = homepageImage("editorial");

const featuredFilmImage = featuredFilm?.poster
  ? filmPoster(featuredFilm.poster)
  : null;
---

<Layout
  title="MADEBYAL — Filmmaker + Photographer in Berlin"
  description="Berlin-based filmmaker and photographer Al Amin creating documentary, events, portraits, commercial work and people-led stories across Germany and Europe."
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">
        {homepage?.eyebrow ?? "Filmmaker + Photographer — Berlin"}
      </p>

      <h1>
        {homepage?.headline ??
          "Films and photographs about people, emotion and story."}
      </h1>

      <p class="intro">
        {homepage?.intro ??
          "Documentary, conversations and ideas, events, portraits and music — made with colour, warmth and human connection."}
      </p>
    </div>
  </section>

  <section class="selected-work">
    <div class="section-heading">
      <p>
        {homepage?.selectedWorkHeading ?? "Selected Work"}
      </p>
    </div>

    <div class="work-grid">
      {
        featuredFilm ? (
          <a
            class="work-card large"
            href={`/film/project/${featuredFilm.slug}`}
          >
            {
              featuredFilmImage ? (
                <img
                  src={featuredFilmImage}
                  alt={featuredFilm.title}
                  loading="eager"
                />
              ) : (
                <div class="film-placeholder"></div>
              )
            }

            <div class="work-meta">
              <h2>{featuredFilm.title}</h2>

              <p>
                Film
                {featuredFilm.client ? ` · ${featuredFilm.client}` : ""}
              </p>
            </div>
          </a>
        ) : (
          <a class="work-card large" href="/film">
            <div class="film-placeholder">
              <span>Film coming next</span>
            </div>

            <div class="work-meta">
              <h2>Film</h2>
              <p>Selected Work</p>
            </div>
          </a>
        )
      }

      <a class="work-card" href="/photography/events">
        {
          eventImage ? (
            <img
              src={eventImage}
              alt="Event photography by Al Ibrahim"
              loading="lazy"
            />
          ) : (
            <div class="image-placeholder"></div>
          )
        }

        <div class="work-meta">
          <h2>Events</h2>
          <p>Photography</p>
        </div>
      </a>

      <a class="work-card" href="/photography/portraits">
        {
          portraitImage ? (
            <img
              src={portraitImage}
              alt="Portrait photography by Al Ibrahim"
              loading="lazy"
            />
          ) : (
            <div class="image-placeholder"></div>
          )
        }

        <div class="work-meta">
          <h2>Portraits</h2>
          <p>Photography</p>
        </div>
      </a>

      <a
        class="work-card large"
        href="/photography/documentary-editorial"
      >
        {
          editorialImage ? (
            <img
              src={editorialImage}
              alt="Documentary and editorial photography by Al Ibrahim"
              loading="lazy"
            />
          ) : (
            <div class="image-placeholder"></div>
          )
        }

        <div class="work-meta">
          <h2>Documentary / Editorial</h2>
          <p>Photography</p>
        </div>
      </a>
    </div>
  </section>

  <section class="disciplines">
    <div class="discipline">
      <a class="discipline-label" href="/film">
        Film
      </a>

      <h2>
        {homepage?.filmHeading ?? "Stories in motion."}
      </h2>

      <p>
        {homepage?.filmDescription ??
          "Documentary, conversations and ideas, commercial work, events, film and music."}
      </p>
    </div>

    <div class="discipline">
      <a class="discipline-label" href="/photography">
        Photography
      </a>

      <h2>
        {homepage?.photographyHeading ??
          "People, moments and atmosphere."}
      </h2>

      <p>
        {homepage?.photographyDescription ??
          "Events, portraits and documentary / editorial photography."}
      </p>
    </div>

    <div class="discipline">
      <a class="discipline-label" href="/projects">
        Projects
      </a>

      <h2>
        {homepage?.projectsHeading ??
          "Personal and collaborative work."}
      </h2>

      <p>
        {homepage?.projectsDescription ??
          "Self-contained projects, experiments and work from film sets."}
      </p>
    </div>
  </section>

  <section class="about-preview">
    <div>
      <a class="section-heading-text" href="/about">
        {homepage?.aboutHeading ?? "About"}
      </a>
    </div>

    <div class="about-copy">
      <p>
        {homepage?.aboutText ??
          "I’m Al Amin, a Berlin-based filmmaker and photographer. I’m drawn to people — how they move, talk, connect and reveal themselves when they stop thinking about the camera."}
      </p>

      <a href="/about">
        More about me →
      </a>
    </div>
  </section>

  <section class="contact">
    <div>
      <p class="section-heading-text">
        {homepage?.contactHeading ?? "Have a project in mind?"}
      </p>

      {
        homepage?.contactText && (
          <p class="contact-text">
            {homepage.contactText}
          </p>
        )
      }
    </div>

    <a class="contact-link" href="/contact">
      {homepage?.contactLinkText ?? "Get in touch →"}
    </a>
  </section>
</Layout>

<style>
  section {
    width: 100%;
  }

  .hero {
    padding: 18px 0 30px;
  }

  .hero-copy {
    width: 100%;
    max-width: 100%;
  }

  .eyebrow,
  .section-heading p,
  .section-heading-text,
  .discipline-label {
    margin: 0;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .eyebrow {
    margin-bottom: 16px;
    opacity: 0.55;
  }

  h1 {
    width: 100%;
    max-width: none;
    margin: 0;
    font-size: clamp(34px, 3.6vw, 56px);
    line-height: 0.98;
    letter-spacing: -0.045em;
    font-weight: 700;
    white-space: normal;
  }

  .intro {
    width: 100%;
    max-width: none;
    margin: 16px 0 0;
    font-size: 16px;
    line-height: 1.4;
    color: #555;
  }

  .selected-work {
    padding: 10px 0 120px;
  }

  .section-heading {
    margin-bottom: 22px;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px 20px;
  }

  .work-card {
    display: block;
  }

  .work-card.large {
    grid-column: 1 / -1;
  }

  .work-card img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .work-card.large img {
    aspect-ratio: 16 / 9;
  }

  .film-placeholder,
  .image-placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: #111;
  }

  .work-card.large .film-placeholder,
  .work-card.large .image-placeholder {
    aspect-ratio: 16 / 9;
  }

  .film-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #aaa;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .work-meta {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 12px;
  }

  .work-meta h2,
  .work-meta p {
    margin: 0;
    font-size: 14px;
    font-weight: 400;
  }

  .work-meta p {
    color: #777;
  }

  .disciplines {
    border-top: 1px solid #ddd;
  }

  .discipline {
    display: grid;
    grid-template-columns: 180px 1fr 1fr;
    gap: 30px;
    padding: 28px 0;
    border-bottom: 1px solid #ddd;
  }

  .discipline h2 {
    margin: 0;
    font-size: 28px;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .discipline > p:last-child {
    max-width: 420px;
    margin: 0;
    color: #666;
    line-height: 1.45;
  }

  .discipline-label:hover,
  .section-heading-text:hover {
    opacity: 0.5;
  }

  .about-preview {
    display: grid;
    grid-template-columns: 180px minmax(0, 680px);
    gap: 30px;
    padding: 120px 0;
  }

  .about-copy p {
    margin: 0 0 24px;
    font-size: 28px;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .about-copy a {
    font-size: 14px;
  }

  .contact {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 30px;
    padding: 60px 0 20px;
    border-top: 1px solid #ddd;
  }

  .contact-text {
    max-width: 500px;
    margin: 12px 0 0;
    color: #666;
    line-height: 1.45;
  }

  .contact-link {
    font-size: clamp(28px, 4vw, 58px);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  @media (max-width: 900px) {
    .hero {
      min-height: auto;
      padding-top: 20px;
    }

    .work-grid {
      grid-template-columns: 1fr;
    }

    .work-card.large {
      grid-column: auto;
    }

    .work-card img,
    .work-card.large img,
    .film-placeholder,
    .work-card.large .film-placeholder,
    .image-placeholder,
    .work-card.large .image-placeholder {
      aspect-ratio: 4 / 3;
    }

    .discipline {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .about-preview {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .contact {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>